---
const specialties = [
  {
    n: '01',
    titleKey: 'swiss.exp.1.title',
    descKey: 'swiss.exp.1.desc',
    title: 'IAM',
    description: 'Identity is a product of its own: OIDC, OAuth2, tokens, multi-tenant realms. Co-founder of FerrisKey, an open-source IAM written in Rust.',
    tags: ['OIDC', 'OAuth2', 'RBAC', 'FerrisKey'],
  },
  {
    n: '02',
    titleKey: 'swiss.exp.2.title',
    descKey: 'swiss.exp.2.desc',
    title: 'Robust systems',
    description: 'Systems that tolerate failure: hexagonal architecture, explicit contracts, observability and SLOs. Designed for the bad day, not only the happy path.',
    tags: ['Hexagonal', 'Observability', 'SLO'],
  },
  {
    n: '03',
    titleKey: 'swiss.exp.3.title',
    descKey: 'swiss.exp.3.desc',
    title: 'Scalability',
    description: 'Horizontal scaling of the business layer only: stateless services, Kubernetes, events. Identity is delegated to the IAM, so the product scales on its own.',
    tags: ['Kubernetes', 'Stateless', 'Event-driven'],
  },
  {
    n: '04',
    titleKey: 'swiss.exp.4.title',
    descKey: 'swiss.exp.4.desc',
    title: 'Sobriety',
