---
import HeroAnimation from './hero-animation.astro'

const START_YEAR = 2016
const years = new Date().getFullYear() - START_YEAR

const disciplines = [
  { n: '01', titleKey: 'swiss.disc.1.title', subKey: 'swiss.disc.1.sub', title: 'IAM', sub: 'OIDC · tokens' },
  { n: '02', titleKey: 'swiss.disc.2.title', subKey: 'swiss.disc.2.sub', title: 'Robust', sub: 'SLO · resilience' },
  { n: '03', titleKey: 'swiss.disc.3.title', subKey: 'swiss.disc.3.sub', title: 'Scale', sub: 'Horizontal · K8s' },
  { n: '04', titleKey: 'swiss.disc.4.title', subKey: 'swiss.disc.4.sub', title: 'Lean', sub: 'Rust · green IT' },
]
---

<style>
  .h-in {
    opacity: 0;
    transform: translateY(14px);
    animation: h-reveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes h-reveal {
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .h-in { animation: none; opacity: 1; transform: none; }
  }
</style>

<section id="top" class="sw-sec">
  <div class="sw-frame">
    <div class="grid lg:grid-cols-2">
      <!-- Cellule texte -->
      <div class="sw-cell flex flex-col justify-between gap-10 border-b border-border pt-24 sm:p-10 sm:pt-[104px] lg:border-b-0 lg:border-r">
        <div class="h-in sw-label flex items-center gap-3 text-muted-foreground" style="animation-delay: 0ms;">
          <span class="inline-block size-3 bg-primary" aria-hidden="true"></span>
          <span data-t="swiss.hero.role">Software architect</span>
          <span class="h-px flex-1 bg-border"></span>
          <span><span id="hero-years">{years}</span> <span data-t="swiss.hero.years">years of experience</span></span>
        </div>

        <div>
          <h1
            class="h-in font-bold leading-[0.88] tracking-[-0.05em]"
            style="animation-delay: 80ms; font-size: clamp(2.75rem, 8vw, 6.25rem);"
          >
            Baptiste<br />Parmantier<span class="text-primary">.</span>
          </h1>

          <p
            class="h-in mt-7 max-w-lg text-lg leading-snug text-muted-foreground"
            style="animation-delay: 180ms;"
            data-t="swiss.hero.lead"
          >
            I design identity, robust and scalable systems, with a light footprint. From the first API contract to the last alert.
          </p>

          <div class="h-in mt-8 flex flex-wrap gap-3" style="animation-delay: 260ms;">
            <a
              href="#projects"
              class="inline-flex items-center gap-2 bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-85"
            >
              <span data-t="swiss.hero.cta1">See my projects</span>
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="#contact"
              class="inline-flex items-center gap-2 border border-foreground px-5 py-3 text-sm font-semibold transition-colors hover:bg-foreground hover:text-background"
            >
              <span data-t="swiss.hero.cta2">Get in touch</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Cellule figure : l'animation occupe toute la cellule -->
      <div class="sw-tint h-in relative min-h-[460px] overflow-hidden" style="animation-delay: 160ms;">
        <div class="sw-label pointer-events-none absolute inset-x-6 top-4 z-10 flex items-center justify-between text-muted-foreground" style="font-size: 0.62rem;">
          <span>Fig.01</span>
          <span>one cat, six paradigms</span>
        </div>
        <div class="absolute inset-0">
          <HeroAnimation />
        </div>
      </div>
    </div>

    <!-- Bande des 4 disciplines : cellules séparées par des filets -->
    <div class="h-in grid grid-cols-2 gap-px border-t border-border bg-border sm:grid-cols-4" style="animation-delay: 340ms;">
      {disciplines.map((d) => (
        <div class="sw-hover bg-background p-5 sm:p-6">
          <p class="sw-label text-primary">{d.n}</p>
          <p class="mt-3 text-2xl font-bold leading-none tracking-tight sm:text-3xl" data-t={d.titleKey}>{d.title}</p>
          <p class="mt-2 font-mono text-xs text-muted-foreground" data-t={d.subKey}>{d.sub}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Garde le compteur juste même si la page a été générée il y a longtemps
  const el = document.getElementById('hero-years')
  if (el) el.textContent = String(new Date().getFullYear() - 2016)
</script>
