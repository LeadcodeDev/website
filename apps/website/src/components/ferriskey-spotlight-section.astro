---
const modules = [
  { n: '01', name: 'Trident', subKey: 'ferriskey.mod1.sub', descKey: 'ferriskey.mod1.desc', sub: 'Multi-factor authentication', description: 'WebAuthn passkeys, TOTP, magic links and recovery codes.' },
  { n: '02', name: 'SeaWatch', subKey: 'ferriskey.mod2.sub', descKey: 'ferriskey.mod2.desc', sub: 'Audit & security events', description: 'Who did what, recorded as audit and security events.' },
  { n: '03', name: 'Compass', subKey: 'ferriskey.mod3.sub', descKey: 'ferriskey.mod3.desc', sub: 'Authentication flow engine', description: 'Compose authentication steps and conditions instead of patching a fixed login.' },
  { n: '04', name: 'Abyss', subKey: 'ferriskey.mod4.sub', descKey: 'ferriskey.mod4.desc', sub: 'Identity provider federation', description: 'Federate OIDC identity providers and LDAP directories, and serve SAML applications.' },
  { n: '05', name: 'Aegis', subKey: 'ferriskey.mod5.sub', descKey: 'ferriskey.mod5.desc', sub: 'Scopes & protocol mappers', description: 'Control which scopes and claims each client receives.' },
  { n: '06', name: 'Webhooks', subKey: 'ferriskey.mod6.sub', descKey: 'ferriskey.mod6.desc', sub: 'Event-driven extensibility', description: 'React to events by calling your own services.' },
]
---

<section
  id="ferriskey"
  class="sw-sec"
  style="--color-primary: #f2670f; --color-primary-foreground: #151513; --sw-tint: color-mix(in oklch, #f2670f 7%, var(--color-background));"
>
  <div class="sw-frame">
    <!-- Ligne titre : annonce les projets (le produit phare puis les autres) -->
    <div class="sw-cell border-b border-border" data-reveal="fade-up">
      <p class="sw-label text-primary"><span>02 / </span><span data-t="projects.label">Projects</span></p>
      <h2 class="sw-h2 mt-5 max-w-2xl" data-t="projects.title">Reliable, lean, open-source products.</h2>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground" data-t="projects.description">
        Each project is a system decision made concrete — architecture choices, protocol design, and long-term maintenance.
      </p>
    </div>

    <div class="grid lg:grid-cols-2">
      <!-- Cellule orange -->
      <div class="sw-cell relative isolate flex flex-col justify-between gap-12 overflow-hidden bg-primary text-primary-foreground sm:p-10" data-reveal="fade-up">
        <!-- Logo FerrisKey en filigrane (silhouette masquée, opacité très réduite) -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -bottom-28 -right-24 -z-10 h-[580px] w-[537px] bg-[#151513] opacity-[0.09]"
          style="-webkit-mask: url(/ferriskey-logo.svg) center / contain no-repeat; mask: url(/ferriskey-logo.svg) center / contain no-repeat;"
        ></div>
        <p class="sw-label"><span data-t="ferriskey.label">Flagship Product</span></p>
        <div>
          <h2
            class="font-bold leading-[0.85] tracking-[-0.06em]"
            style="font-size: clamp(3.25rem, 9vw, 6.5rem);"
            data-t="ferriskey.title"
          >FerrisKey</h2>
          <p class="mt-5 max-w-md text-xl font-medium leading-snug" data-t="ferriskey.subtitle">
            Open-source IAM platform, built in Rust
          </p>
          <a
            href="https://landscape.cncf.io/?item=provisioning--security-compliance--ferriskey"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex items-center gap-2 rounded-[2px] border border-[#151513]/40 px-2.5 py-1.5 font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-[#151513] transition-colors hover:bg-[#151513] hover:text-white"
          >
            <span data-t="ferriskey.cncf">Listed in the CNCF Landscape</span>
            <span aria-hidden="true">↗</span>
          </a>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="https://ferriskey.rs"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-[#151513] px-5 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-85"
            >
              <span data-t="ferriskey.cta.website">Visit ferriskey.rs</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a
              href="https://github.com/ferriskey/ferriskey"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-[#151513] px-5 py-3 text-sm font-semibold text-[#151513] transition-colors hover:bg-[#151513] hover:text-white"
            >
              <span data-t="ferriskey.cta.github">View on GitHub</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Modules : 6 cartes, 2 colonnes -->
      <div class="grid gap-px border-t border-border bg-border sm:grid-cols-2 lg:border-l lg:border-t-0" data-reveal="fade-up" data-reveal-delay="80">
        {modules.map((m) => (
          <div class="sw-hover bg-background sw-cell">
            <p class="sw-label text-primary">{m.n}</p>
            <h3 class="mt-3 text-xl font-bold tracking-tight">{m.name}</h3>
            <p class="mt-1 font-mono text-[10px] uppercase tracking-wider text-muted-foreground" data-t={m.subKey}>{m.sub}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground" data-t={m.descKey}>{m.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
