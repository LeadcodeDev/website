---
import { readdirSync, readFileSync } from "node:fs"
import { join } from "node:path"

interface BlogPost {
  title: string
  description: string
  date: Date
  tags: string[]
  slug: string
  cover?: string
}

function parseFrontmatter(content: string): Record<string, any> {
  const match = content.match(/^---\n([\s\S]*?)\n---/)
  if (!match) return {}

  const yaml = match[1]
  const data: Record<string, any> = {}

  for (const line of yaml.split('\n')) {
    const kv = line.match(/^(\w[\w.]*)\s*:\s*(.+)$/)
    if (!kv) continue
    const [, key, rawValue] = kv
    let value: any = rawValue.trim()

    if (value.startsWith('[') && value.endsWith(']')) {
      value = value.slice(1, -1).split(',').map((s: string) => s.trim().replace(/^['"]|['"]$/g, ''))
    }
    else if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) {
      value = value.slice(1, -1)
    }

    data[key] = value
  }

  return data
}

function loadBlogPosts(locale: string): BlogPost[] {
  const postsDir = join(process.cwd(), '..', 'blog', 'src', 'content', 'posts', locale)
  try {
    const files = readdirSync(postsDir).filter((f) => f.endsWith('.mdx') || f.endsWith('.md'))
    const posts: BlogPost[] = []

    for (const file of files) {
      const content = readFileSync(join(postsDir, file), 'utf-8')
      const data = parseFrontmatter(content)
      // Drafts are visible in dev so articles can be proofread before publishing.
      if (data.status !== 'published' && !import.meta.env.DEV) continue

      posts.push({
        title: data.title ?? '',
        description: data.description ?? '',
        date: new Date(data.date),
        tags: Array.isArray(data.tags) ? data.tags : [],
        slug: file.replace(/\.mdx?$/, '').replace(/ /g, '-'),
        cover: data.cover,
      })
    }

    return posts.sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 3)
  } catch {
    return []
  }
}

const blogUrl = import.meta.env.PUBLIC_BLOG_URL || ''
const locales = [
  { loc: 'en', posts: loadBlogPosts('en') },
  { loc: 'fr', posts: loadBlogPosts('fr') },
]

function formatDate(date: Date, locale: string) {
  return date.toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' })
}
---

{locales[0].posts.length > 0 && (
  <section id="articles" class="sw-sec">
    <div class="sw-frame">
      <div class="sw-cell" data-reveal="fade-up">
        <p class="sw-label text-primary"><span>03 / </span><span data-t="articles.label">Blog</span></p>
        <h2 class="sw-h2 mt-5 max-w-2xl" data-t="articles.title">Latest articles</h2>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground" data-t="swiss.articles.description">
          Write-ups on IAM, architecture and the systems I build.
        </p>
        <a href={blogUrl} class="sw-label mt-6 inline-flex items-center gap-2 border-b border-primary pb-1 transition-colors hover:text-primary">
          <span data-t="articles.viewAll">View all articles</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {locales.map(({ loc, posts }) => (
        <div data-locale-articles={loc} style={loc === 'fr' ? 'display: none;' : undefined} data-reveal="fade-up" data-reveal-delay="80">
          <!-- Les 2 derniers articles avec leur vignette -->
          <div class="grid gap-px border-t border-border bg-border md:grid-cols-2">
            {posts.slice(0, 2).map((post) => (
              <a href={`${blogUrl}/${loc}/${post.slug}`} class="sw-hover group flex flex-col bg-background">
                <div class="aspect-[16/9] overflow-hidden border-b border-border bg-muted">
                  {post.cover ? (
                    <img src={post.cover} alt={post.title} class="h-full w-full object-cover" loading="lazy" />
                  ) : (
                    <>
                      <img src={`${blogUrl}/${loc}/${post.slug}/thumbnail.png`} alt={post.title} class="thumb-light h-full w-full object-cover" loading="lazy" />
                      <img src={`${blogUrl}/${loc}/${post.slug}/thumbnail-dark.png`} alt={post.title} class="thumb-dark h-full w-full object-cover" loading="lazy" />
                    </>
                  )}
                </div>
                <div class="sw-cell flex flex-1 flex-col">
                  <div class="flex items-center justify-between gap-4">
                    <time class="font-mono text-xs uppercase tracking-wider text-muted-foreground">{formatDate(post.date, loc)}</time>
                    <span class="text-lg text-muted-foreground transition-transform duration-200 group-hover:rotate-45 group-hover:text-primary" aria-hidden="true">↗</span>
                  </div>
                  <h3 class="mt-3 text-xl font-bold leading-tight tracking-tight">{post.title}</h3>
                  <p class="mt-auto pt-4 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">{post.tags.slice(0, 3).join(' · ')}</p>
                </div>
              </a>
            ))}
          </div>
          <!-- Les suivants en liste -->
          {posts.slice(2).map((post) => (
            <a
              href={`${blogUrl}/${loc}/${post.slug}`}
              class="sw-hover group grid items-baseline gap-3 border-t border-border sw-cell md:grid-cols-[160px_1fr_200px_24px] md:gap-6"
            >
              <time class="font-mono text-xs uppercase tracking-wider text-muted-foreground">{formatDate(post.date, loc)}</time>
              <h3 class="text-xl font-bold leading-tight tracking-tight">{post.title}</h3>
              <p class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground">{post.tags.slice(0, 3).join(' · ')}</p>
              <span class="hidden text-lg text-muted-foreground transition-transform duration-200 group-hover:rotate-45 group-hover:text-primary md:block" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>
)}

<script>
  function showLocaleArticles() {
    const match = document.cookie.match(/(?:^|; )locale=([^;]*)/)
    const cookie = match ? match[1] : null
    const browser = (navigator.language || '').split('-')[0]
    const locale = (cookie === 'en' || cookie === 'fr') ? cookie
      : (browser === 'en' || browser === 'fr') ? browser : 'en'

    document.querySelectorAll('[data-locale-articles]').forEach(function (el) {
      ;(el as HTMLElement).style.display = el.getAttribute('data-locale-articles') === locale ? '' : 'none'
    })
  }

  showLocaleArticles()
  document.addEventListener('astro:after-swap', showLocaleArticles)
</script>

<style>
  /* Vignette adaptée au thème actif (classe, pas media query) */
  .thumb-dark {
    display: none;
  }
  :global(html.dark) .thumb-light {
    display: none;
  }
  :global(html.dark) .thumb-dark {
    display: block;
  }
</style>
