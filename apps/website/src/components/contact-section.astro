---
const socials = [
  { href: 'https://github.com/LeadcodeDev', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/baptiste-parmantier', label: 'LinkedIn' },
  { href: 'mailto:baptiste.parmantier.pro@gmail.com', label: 'Email' },
]
---

<section id="contact" class="sw-sec">
  <div class="sw-frame">
    <div class="grid lg:grid-cols-[3fr_1fr]">
      <div class="sw-cell border-b border-border sm:p-10 lg:border-b-0 lg:border-r" data-reveal="fade-up">
        <p class="sw-label text-primary"><span>04 / </span><span data-t="swiss.contact.label">Contact</span></p>
        <h2 class="mt-8 font-bold leading-[0.9] tracking-[-0.05em]" style="font-size: clamp(2.25rem, 5.6vw, 4.25rem);" data-t="contact.title">
          Let's design something together
        </h2>
        <p class="mt-6 max-w-lg text-base leading-relaxed text-muted-foreground" data-t="contact.description">
          Have a system to design, an architecture to review, or just want to talk tech? Feel free to reach out.
        </p>
      </div>

      <div class="sw-tint flex flex-col" data-reveal="fade-up" data-reveal-delay="80">
        <a
          href="mailto:baptiste.parmantier.pro@gmail.com"
          class="sw-cell flex items-center justify-between gap-4 bg-primary text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-85"
        >
          <span data-t="contact.email">Send an email</span>
          <span aria-hidden="true">→</span>
        </a>
        <div class="grid flex-1 gap-px bg-border">
          {socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={s.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
              class="sw-hover sw-label flex items-center justify-between bg-background px-6 py-4 text-muted-foreground hover:text-primary sm:px-8"
            >
              <span>{s.label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
