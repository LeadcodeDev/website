---
import Base from './base.astro'
import { formatDate } from '../lib/posts'
import { getTagLabel } from '../lib/tags'
import { TableOfContents } from '../components/TableOfContents'
import { ShareButtons } from '../components/ShareButtons'
import { useTranslations } from '../i18n/utils'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  title: string
  description: string
  date: Date
  tags: string[]
  cover?: string
  thumbnail?: string
  readingTime: number
  headings: Heading[]
  url: string
  author?: { name: string; title: string; avatar: string; href?: string }
  locale?: string
  locales?: string[]
  localeSwitchUrls?: Record<string, string>
}

const { title, description, date, tags, cover, thumbnail, readingTime, headings, url, author, locale = 'en', locales, localeSwitchUrls } = Astro.props
const t = useTranslations(locale)
---

<Base title={title} description={description} thumbnail={thumbnail} locale={locale} locales={locales} localeSwitchUrls={localeSwitchUrls} fixedBackground>
  <!-- En-tête de l'article : titre à gauche, fiche de l'article à droite (même largeur que le sommaire) -->
  <section class="sw-sec">
    <div class="sw-frame">
      <div class="grid lg:grid-cols-[1fr_16rem]">
        <div class="sw-cell sm:p-10">
          <a href="/" class="sw-label text-primary transition-opacity hover:opacity-70">
            &larr; {t('post.back')}
          </a>
          <h1 class="mt-8 font-bold leading-[0.95] tracking-[-0.045em]" style="font-size: clamp(2.25rem, 5vw, 3.75rem);">{title}</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">{description}</p>
        </div>

        <dl class="flex flex-col divide-y divide-border border-t border-border lg:border-l lg:border-t-0">
          <div class="p-6">
            <dt class="sw-label text-muted-foreground">{t('post.published')}</dt>
            <dd class="mt-2 text-lg font-bold tracking-tight">{formatDate(date, locale)}</dd>
          </div>
          <div class="p-6">
            <dt class="sw-label text-muted-foreground">{t('post.readingTime')}</dt>
            <dd class="mt-2 text-lg font-bold tracking-tight">{readingTime} {t('hero.minRead')}</dd>
          </div>
          {tags.length > 0 && (
            <div class="p-6">
              <dt class="sw-label text-muted-foreground">{t('post.topics')}</dt>
              <dd class="mt-3 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <a
                    href={`/?tags=${encodeURIComponent(tag)}`}
                    class="rounded-[2px] border border-border px-2 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.06em] text-muted-foreground transition-colors hover:border-primary hover:text-primary"
                  >
                    {getTagLabel(tag, locale)}
                  </a>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </div>
  </section>

  {cover && (
    <section class="sw-sec">
      <div class="sw-frame">
        <img src={cover} alt={title} class="aspect-2/1 w-full object-cover" />
      </div>
    </section>
  )}

  <!-- Corps de l'article : colonne de partage | article | sommaire, séparées par des filets -->
  <section class="sw-sec">
    <div class="sw-frame relative">
      <div class="flex">
        <!-- Liens de partage (collants) : dans la marge gauche, contre le filet du cadre, quand il y a la place ;
             sinon dans le cadre, à gauche de l'article -->
        <aside class="hidden w-16 shrink-0 border-r border-border bg-background lg:block min-[1210px]:absolute min-[1210px]:right-full min-[1210px]:top-0 min-[1210px]:h-full min-[1210px]:border-l">
          <ShareButtons url={url} title={title} locale={locale} client:load />
        </aside>

        <!-- Article -->
        <article class="sw-cell min-w-0 flex-1">
          <div class="prose prose-neutral dark:prose-invert max-w-none">
            <slot />
          </div>
          <!-- Partage mobile -->
          <div class="mt-10 lg:hidden">
            <ShareButtons url={url} title={title} locale={locale} horizontal client:load />
          </div>
        </article>

        <!-- Colonne droite : sommaire (collant) -->
        <aside class="hidden w-64 shrink-0 border-l border-border py-6 pr-6 xl:block">
          <TableOfContents headings={headings} locale={locale} author={author} client:load />
        </aside>
      </div>
    </div>
  </section>
</Base>
