---
import { getCollection } from 'astro:content'
import Base from '../layouts/base.astro'
import { TagFilter } from '../components/TagFilter'
import PostCard from '../components/PostCard.astro'
import { getVisiblePosts, isDraft, getPostHref, getPostLocale, getLocales, getAllTags, getReadingTime } from '../lib/posts'
import { getAuthor } from '../lib/authors'
import { defaultLang, ui } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'

const allPosts = await getCollection('posts')
const locales = getLocales(allPosts)
const posts = getVisiblePosts(allPosts)
const tags = getAllTags(posts)
const locale = defaultLang
const t = useTranslations(locale)
---

<Base title={t('index.title')} locale={locale} locales={locales}>
  <!-- En-tête -->
  <section class="sw-sec">
    <div class="sw-frame">
      <div class="sw-cell sm:p-10">
        <p class="sw-label text-primary">Journal</p>
        <h1 class="mt-5 font-bold leading-[0.9] tracking-[-0.05em]" style="font-size: clamp(2.75rem, 7vw, 5.25rem);">
          <span data-i18n="index.heading.prefix">{t('index.heading.prefix')}</span>{' '}
          <span class="text-primary" data-i18n="index.heading.highlight">{t('index.heading.highlight')}</span>
        </h1>
      </div>
    </div>
  </section>

  <!-- Filtres -->
  <section class="sw-sec">
    <div class="sw-frame">
      <div class="sw-cell">
        <TagFilter tags={tags} locale={locale} client:load />
      </div>
    </div>
  </section>

  <!-- Articles : cellules séparées par des filets -->
  <section class="sw-sec">
    <div class="sw-frame">
      {posts.length > 0 && (
        <div class="grid overflow-hidden md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <div class="-ml-px -mt-px h-full border-l border-t border-border" data-tags={JSON.stringify(post.data.tags)} data-title={post.data.title} data-description={post.data.description ?? ''} data-locale={getPostLocale(post)}>
              <PostCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                tags={post.data.tags}
                cover={post.data.cover}
                href={getPostHref(post)}
                locale={getPostLocale(post)}
                readingTime={getReadingTime(post.body ?? '')}
                author={post.data.author ? getAuthor(post.data.author) : undefined}
                draft={isDraft(post)}
              />
            </div>
          ))}
        </div>
      )}

      <!-- Aucun article -->
      {posts.length === 0 && (
        <div class="sw-cell py-20 text-center">
          <p class="text-lg text-muted-foreground">{t('index.empty')}</p>
        </div>
      )}
    </div>
  </section>
</Base>

<script define:vars={{ supportedLocales: locales, fallbackLocale: locale, translations: ui }}>
  function detectLocale() {
    var match = document.cookie.match(/(?:^|; )locale=([^;]*)/)
    var cookieLocale = match ? match[1] : null
    var browserLang = (navigator.language || '').split('-')[0]
    return (cookieLocale && supportedLocales.includes(cookieLocale))
      ? cookieLocale
      : supportedLocales.includes(browserLang) ? browserLang : fallbackLocale
  }

  function applyLocale(detected) {
    window.__detectedLocale = detected
    document.querySelectorAll('[data-locale]').forEach(function(el) {
      el.style.display = el.dataset.locale === detected ? '' : 'none'
    })
    window.dispatchEvent(new CustomEvent('locale:change', { detail: { locale: detected } }))
  }

  window.addEventListener('locale:change', function(e) {
    var t = translations[e.detail.locale] || translations[fallbackLocale]
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      var key = el.dataset.i18n
      if (t[key] !== undefined) el.textContent = t[key]
    })
  })

  applyLocale(detectLocale())
  document.addEventListener('astro:after-swap', function() { applyLocale(detectLocale()) })
</script>
