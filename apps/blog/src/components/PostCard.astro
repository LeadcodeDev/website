---
import { formatDate } from '../lib/posts'
import { getTagLabel } from '../lib/tags'
import type { Author } from '../lib/authors'

interface Props {
  title: string
  description?: string
  date: Date
  tags: string[]
  cover?: string
  href: string
  locale?: string
  readingTime: number
  author?: Author
  draft?: boolean
  class?: string
}

const { title, description, date, tags, cover, href, locale, draft = false, class: className } = Astro.props
---

<article class:list={['group h-full', className]}>
  <a href={href} class="sw-hover group relative flex h-full min-h-72 flex-col bg-background">
    <!-- Couverture : seulement quand l'article en a une (la vignette générée répète le titre) -->
    {cover && (
      <div class="aspect-16/10 shrink-0 overflow-hidden border-b border-border bg-muted">
        <img src={cover} alt={title} class="h-full w-full object-cover" loading="lazy" />
      </div>
    )}

    <div class="sw-cell flex flex-1 flex-col">
      <div class="flex items-center justify-between gap-3">
        <p class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-muted-foreground">
          {draft && (
            <span class="rounded-[2px] border border-amber-500/50 bg-amber-500/10 px-1.5 py-0.5 text-[9px] font-semibold tracking-wider text-amber-600 dark:text-amber-400">
              Draft
            </span>
          )}
          <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
        </p>
        <span class="shrink-0 text-lg text-muted-foreground transition-transform duration-200 group-hover:rotate-45 group-hover:text-primary" aria-hidden="true">↗</span>
      </div>

      <h2 class="mt-5 text-2xl font-bold leading-tight tracking-tight text-foreground line-clamp-4">{title}</h2>
      {description && <p class="mt-3 text-sm leading-relaxed text-muted-foreground line-clamp-3">{description}</p>}

      {tags.length > 0 && (
        <p class="mt-auto pt-6 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
          {tags.slice(0, 3).map((tag) => getTagLabel(tag, locale)).join(' · ')}
        </p>
      )}
    </div>
  </a>
</article>

